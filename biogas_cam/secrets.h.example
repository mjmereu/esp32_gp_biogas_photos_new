// Copy this file to secrets.h (same folder) and fill in your own values.
// secrets.h is in .gitignore so your credentials never get committed.
#define WIFI_SSID     "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"   // "" for an open network

// The part of your Apps Script web-app URL between /macros/s/ and /exec.
// Same value for all boards.
#define GOOGLE_SCRIPT_ID "XXXXXXXXXXXXXXXXXXXXXX"

// Unique name for THIS board; must match a row in the Sheet's Config tab.
// Letters, numbers, - and _ only (no spaces). Change this for each board you flash.
#define DEVICE_ID "cam_1"
